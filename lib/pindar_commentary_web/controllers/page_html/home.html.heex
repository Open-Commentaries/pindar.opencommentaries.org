<Layouts.flash_group flash={@flash} />
<div class="relative isolate overflow-hidden">
  <div
    aria-hidden="true"
    class="absolute top-10 left-[calc(50%-4rem)] -z-10 transform-gpu blur-3xl sm:left-[calc(50%-18rem)] lg:top-[calc(50%-30rem)] lg:left-48 xl:left-[calc(50%-24rem)]"
  >
    <div
      style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"
      class="aspect-1108/632 w-277 bg-linear-to-r from-primary to-accent opacity-20"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pt-10 pb-24 sm:pb-32 lg:flex lg:px-8 lg:py-32">
    <div class="mx-auto max-w-2xl shrink-0 lg:mx-0 lg:pt-8">
      <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">Pindar</h1>
      <p class="mt-6 text-base-content/70 text-lg">
        A commentary in progress on the odes of Pindar. Select a collection below to begin reading.
      </p>

      <div class="mt-10 flex flex-col gap-4">
        <%= for collection <- @collections do %>
          <details class="group rounded-box border border-primary/10 bg-linear-to-br from-primary/5 to-accent/5">
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-4 text-lg font-semibold rounded-box hover:bg-primary/10 transition-colors">
              <%= collection.title %> Odes
              <svg
                class="h-5 w-5 transition-transform group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </summary>
            <ul class="px-6 pb-4 pt-1 flex flex-col gap-1">
              <%= for poem <- collection.poems do %>
                <li>
                  <a
                    href={"/" <> poem["urn"]}
                    class="block rounded-lg px-3 py-1.5 text-sm hover:bg-primary/10 transition-colors"
                  >
                    <%= collection.title %> <%= poem["n"] %>
                  </a>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </div>

    <div class="mx-auto mt-16 flex max-w-2xl sm:mt-24 lg:mt-0 lg:mr-0 lg:ml-10 lg:max-w-none lg:flex-none xl:ml-32">
      <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
        <img
          src={~p"/images/panathenaic-amphora.jpg"}
          alt="Terracotta Panathenaic prize amphora, Euphiletos Painter, Metropolitan Museum of Art (CC0)"
          class="w-[36rem] rounded-md bg-base-200 shadow-xl ring-1 ring-base-300"
        />
        <p class="mt-2 text-xs text-base-content/50">
          Euphiletos Painter, CC0, via
          <a
            href="https://commons.wikimedia.org/wiki/File:Terracotta_Panathenaic_prize_amphora_MET_DP245711.jpg"
            class="underline hover:text-base-content/70"
          >
            Wikimedia Commons
          </a>
        </p>
      </div>
    </div>
  </div>
</div>
